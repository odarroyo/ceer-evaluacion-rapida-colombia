# Leave all Supabase values empty for demo mode. Use staging or production
# only with a complete credential set; partial configuration is rejected.
NEXT_PUBLIC_CEER_ENV=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public, deployment-specific operator branding. This identifies the institution
# operating a deployment; it does not replace CEER's fixed origin credit.
NEXT_PUBLIC_OPERATOR_NAME=Institución usuaria
NEXT_PUBLIC_OPERATOR_SHORT_NAME=Institución
NEXT_PUBLIC_OPERATOR_LOGO_PATH=/operator-placeholder.svg

# Server-only. Never expose this value with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=

# Temporary compatibility only; SUPABASE_SECRET_KEY takes precedence.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional operational integrations.
SENTRY_DSN=
PHOTO_BACKUP_WEBHOOK_URL=
